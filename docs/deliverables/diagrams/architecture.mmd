flowchart TB
    user(["User at a terminal"])
    root["<b>pim.py</b> (composition root)<br/>PIM() → App(pim) → Terminal(app) → run()"]

    subgraph view["view package"]
        curses["<b>CursesUI</b><br/>full-screen interface on a TTY"]
        term["<b>Terminal</b><br/>prompts · line interface · Alarm Alerts"]
        helpers["layout · widgets · file_browser · keys<br/>theme · textwidth · stdin_reader"]
    end

    subgraph controller["controller package"]
        app["<b>App</b><br/>one user action → model calls<br/>Current Result · Selection · status line"]
        errors["<b>errors.message_for</b><br/>exception → status line"]
    end

    subgraph model["model package"]
        pim["<b>PIM</b><br/>Working Collection · Ids · due alarms"]
        crit["<b>Criterion</b> tree<br/>parse_criterion"]
        pir["<b>PIR</b> classes · alarms"]
        codec["<b>pimfile</b><br/>JSON codec · atomic write"]
    end

    file[("PIM File<br/>*.pim (UTF-8 JSON)")]

    user <-- "keys / full-screen display" --> curses
    user <-- "lines / line display" --> term
    curses -- "finished answers" --> term
    term --- helpers
    term -- "one call per action" --> app
    app --- errors
    app -- "create · modify · delete · search<br/>save · load · due_alarms" --> pim
    app -- "parse_criterion" --> crit
    pim --> crit
    pim --> pir
    pim --> codec
    codec -- "read · atomic write" --> file
    view -. "uses PIR, DueAlarm, and alarm value types" .-> model
    root -. "creates" .-> view
    root -. "creates" .-> controller
    root -. "creates" .-> model
