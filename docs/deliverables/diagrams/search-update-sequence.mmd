sequenceDiagram
    autonumber
    actor User
    participant T as view.Terminal
    participant A as controller.App
    participant P as model.PIM
    participant C as model.criterion
    participant E as model.Event (copy)

    User->>T: search type = event &&<br/>description contains "COMP"
    T->>A: search(line)
    A->>C: parse_criterion(line)
    C-->>A: And(TypeIs("event"),<br/>Contains("description", "comp"))
    A->>P: search(criterion)
    loop every PIR in Id order
        P->>C: criterion.matches(pir)
        C-->>P: True / False
    end
    P-->>A: [Event 4]
    A->>A: Current Result = [Event 4]<br/>select Id 4, "1 match(es)"
    T-->>User: list shows the match,<br/>details show Event 4

    User->>T: modify
    T->>A: selected()
    A-->>T: Event 4
    T-->>User: prompt each field<br/>(empty keeps)
    User->>T: start = 2026-09-21 18:30
    T->>A: modify({start: ...})
    A->>P: modify(4, fields)
    P->>E: copy.copy(Event 4)
    P->>E: modify(fields)
    E->>E: parse start,<br/>check alarm times
    alt valid and changed
        E-->>P: ok
        P->>P: replace Id 4 with the copy,<br/>dirty = true
        P-->>A: updated Event 4
        A->>P: search(criterion) again
        A-->>T: status "Modified Id 4"
        T-->>User: new start, moved<br/>relative alarm times
    else ValidationError
        E-->>P: raise ValidationError
        P-->>A: raise (original<br/>Event 4 untouched)
        A-->>T: status = error message
        T-->>User: error on the status line,<br/>data unchanged
    end
